@url = http://localhost:7070/api

# Creates and logs in author, otheruser and admin, and sets
# authorToken, otherToken and adminToken
run ./Auth.http

### --- SETUP: look up the ids of the logged-in test users ---

### Who is otheruser
GET {{url}}/auth/me
Authorization: Bearer {{otherToken}}

> {%
    client.test("auth/me returns the logged-in user", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.username === "otheruser", "Expected otheruser but got " + response.body.username);
    });
    client.global.set("otherId", response.body.id);
%}

### auth/me without a token
GET {{url}}/auth/me

> {%
    client.test("Guest cannot call auth/me", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### --- CREATE AND LOGIN ---

### Create a new user (unique name on every run)
POST {{url}}/users
Content-Type: application/json

{
  "username": "test-{{$timestamp}}",
  "email": "test-{{$timestamp}}@test.dk",
  "password": "test123"
}

> {%
    client.test("Create user returns 201 with an id", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.id, "No id in response");
        client.assert(response.body.password === undefined, "Password must not be sent back");
        client.assert(response.body.hashedPassword === undefined, "Password hash must not be sent back");
    });
    client.global.set("newUserId", response.body.id);
    client.global.set("newUsername", response.body.username);
%}

### Create a user with a taken username
POST {{url}}/users
Content-Type: application/json

{ "username": "otheruser", "email": "duplicate@test.dk", "password": "test123" }

> {%
    client.test("Duplicate username gives 409", function () {
        client.assert(response.status === 409, "Expected 409 but got " + response.status);
    });
%}

### Login as the new user
POST {{url}}/auth/login
Content-Type: application/json

{ "username": "{{newUsername}}", "password": "test123" }

> {%
    client.test("New user can log in", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.token, "No token in response");
    });
    client.global.set("newUserToken", response.body.token);
%}

### Login with wrong password
POST {{url}}/auth/login
Content-Type: application/json

{ "username": "otheruser", "password": "wrong-password" }

> {%
    client.test("Wrong password gives 401", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### --- READ (admin only) ---

### Admin gets all users
GET {{url}}/users
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin can list all users", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(Array.isArray(response.body), "Response is not a list");
    });
%}

### Normal user tries to get all users
GET {{url}}/users
Authorization: Bearer {{otherToken}}

> {%
    client.test("Normal user cannot list all users", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### Admin gets one user
GET {{url}}/users/{{newUserId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin can get one user", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.id == client.global.get("newUserId"), "Wrong user returned");
    });
%}

### Normal user tries to get one user
GET {{url}}/users/{{newUserId}}
Authorization: Bearer {{otherToken}}

> {%
    client.test("Normal user cannot get another user", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### Admin gets a user that doesn't exist
GET {{url}}/users/999999
Authorization: Bearer {{adminToken}}

> {%
    client.test("Missing user gives 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### --- UPDATE ---

### New user updates themself
PUT {{url}}/users/{{newUserId}}
Authorization: Bearer {{newUserToken}}
Content-Type: application/json

{ "email": "updated-{{$timestamp}}@test.dk" }

> {%
    client.test("User can update themself", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Other user tries to update the new user
PUT {{url}}/users/{{newUserId}}
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{ "email": "hacked@test.dk" }

> {%
    client.test("User cannot update someone else", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### --- ROLES (admin only) ---

### Normal user tries to make themself admin
POST {{url}}/users/{{otherId}}/roles/ADMIN
Authorization: Bearer {{otherToken}}

> {%
    client.test("Normal user cannot give roles", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### Admin gives the new user the ADMIN role
POST {{url}}/users/{{newUserId}}/roles/ADMIN
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin can give a role", function () {
        client.assert(response.status >= 200 && response.status < 300,
            "Expected 2xx but got " + response.status);
    });
%}

### Admin gives a role that doesn't exist
POST {{url}}/users/{{newUserId}}/roles/WIZARD
Authorization: Bearer {{adminToken}}

> {%
    client.test("Unknown role gives 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### Admin removes the ADMIN role again
DELETE {{url}}/users/{{newUserId}}/roles/ADMIN
Authorization: Bearer {{adminToken}}

> {%
    client.test("Admin can remove a role", function () {
        client.assert(response.status >= 200 && response.status < 300,
            "Expected 2xx but got " + response.status);
    });
%}

### --- DELETE (last, so the tests above still have the user) ---

### Other user tries to delete the new user
DELETE {{url}}/users/{{newUserId}}
Authorization: Bearer {{otherToken}}

> {%
    client.test("User cannot delete someone else", function () {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### New user deletes themself
DELETE {{url}}/users/{{newUserId}}
Authorization: Bearer {{newUserToken}}

> {%
    client.test("User can delete themself", function () {
        client.assert(response.status === 200 || response.status === 204,
            "Expected 200 or 204 but got " + response.status);
    });
%}

### The deleted user is gone
GET {{url}}/users/{{newUserId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Deleted user gives 404", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}
