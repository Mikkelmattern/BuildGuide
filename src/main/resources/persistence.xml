<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="your-unit-name">
        <class>app.entities.Unicorn</class>


        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/jpa_unicorn"/>
            <property name="jakarta.persistence.jdbc.user" value="${DB_USERNAME}"/>
            <property name="jakarta.persistence.jdbc.password" value="${DB_PASSWORD}"/>
            <!-- dialect, hbm2ddl.auto, etc. -->
        </properties>
    </persistence-unit>
</persistence>