@url = http://localhost:7070/api

### --- SETUP: run these first ---

### Login as admin
POST {{url}}/auth/login
Content-Type: application/json

{ "username": "admin", "password": "test123" }

> {%
    client.test("Admin login works", function () {
        client.assert(response.status === 200, "Admin login failed with " + response.status);
    });
    client.global.set("adminToken", response.body.token);
%}

### Create author
POST {{url}}/users
Content-Type: application/json

{ "username": "author", "email": "mini0001@stud.ek.dk", "password": "test123" }

### Create other user
POST {{url}}/users
Content-Type: application/json

{ "username": "otheruser", "email": "mini0002@stud.ek.dk", "password": "test123" }

### Login as author
POST {{url}}/auth/login
Content-Type: application/json

{ "username": "author", "password": "test123" }

> {% client.global.set("authorToken", response.body.token); %}

### Login as other user
POST {{url}}/auth/login
Content-Type: application/json

{ "username": "otheruser", "password": "test123" }

> {% client.global.set("otherToken", response.body.token); %}

### --- SETUP GAMES ---
# Each game is found on RAWG by search, then imported.
# An import gives 409 if the game is already in the database (no restart since the last run),
# which is fine: the game is there either way.

### Search RAWG for Elden Ring
GET {{url}}/games/search?query=elden%20ring
Authorization: Bearer {{adminToken}}

> {% client.global.set("eldenRingRawgId", response.body[0].id); %}

### Import Elden Ring
POST {{url}}/games/import/{{eldenRingRawgId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Elden Ring is imported", function () {
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409 but got " + response.status);
    });
%}

### Search RAWG for Baldur's Gate 3
GET {{url}}/games/search?query=baldurs%20gate%203
Authorization: Bearer {{adminToken}}

> {% client.global.set("bg3RawgId", response.body[0].id); %}

### Import Baldur's Gate 3
POST {{url}}/games/import/{{bg3RawgId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Baldur's Gate 3 is imported", function () {
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409 but got " + response.status);
    });
%}

### Search RAWG for Hollow Knight
GET {{url}}/games/search?query=hollow%20knight
Authorization: Bearer {{adminToken}}

> {% client.global.set("hollowKnightRawgId", response.body[0].id); %}

### Import Hollow Knight
POST {{url}}/games/import/{{hollowKnightRawgId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("Hollow Knight is imported", function () {
