%}

### Search RAWG for The Witcher 3
GET {{url}}/games/search?query=the%20witcher%203
Authorization: Bearer {{adminToken}}

> {% client.global.set("witcherRawgId", response.body[0].id); %}

### Import The Witcher 3
POST {{url}}/games/import/{{witcherRawgId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("The Witcher 3 is imported", function () {
        client.assert(response.status === 201 || response.status === 409,
            "Expected 201 or 409 but got " + response.status);
    });
%}

### Look up the database id of Elden Ring
GET {{url}}/games

> {%
    client.test("Imported games are in the database", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
        client.assert(response.body.length >= 4, "Expected at least 4 games but got " + response.body.length);
    });
    const eldenRing = response.body.find(g => g.rawgId == client.global.get("eldenRingRawgId"));
    client.global.set("gameId", eldenRing.id);
%}

### --- SETUP GUIDE ---
# A guide owned by author, for Elden Ring (gameId), with this tree:
#   Act 1                      (act1Id)
#   ├── Limgrave               (limgraveId)
#   │   └── Church of Elleh    (churchId)
#   └── Stormveil Castle       (stormveilId)
#   Act 2                      (act2Id)

### Create a guide owned by author
POST {{url}}/guides
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Setup guide", "gameId": {{gameId}} }

> {%
    client.test("Setup guide is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.gameId == client.global.get("gameId"), "Guide is not linked to the game");
    });
    client.global.set("guideId", response.body.id);
%}

### Act 1
POST {{url}}/guides/{{guideId}}/nodes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Act 1", "content": "Act 1 overview", "storyOrderNumber": 1, "priorityNumber": 2 }

> {%
    client.test("Act 1 is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("act1Id", response.body.id);
%}

### Limgrave, under Act 1
POST {{url}}/guides/{{guideId}}/nodes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Limgrave", "content": "The starting area", "parentId": {{act1Id}}, "storyOrderNumber": 1, "priorityNumber": 1 }

> {%
    client.test("Limgrave is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("limgraveId", response.body.id);
%}

### Church of Elleh, under Limgrave
POST {{url}}/guides/{{guideId}}/nodes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Church of Elleh", "content": "Smithing table and merchant", "parentId": {{limgraveId}}, "storyOrderNumber": 1, "priorityNumber": 1 }

> {%
    client.test("Church of Elleh is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("churchId", response.body.id);
%}

### Stormveil Castle, under Act 1
POST {{url}}/guides/{{guideId}}/nodes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Stormveil Castle", "content": "First legacy dungeon", "parentId": {{act1Id}}, "storyOrderNumber": 2, "priorityNumber": 3 }

> {%
    client.test("Stormveil Castle is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("stormveilId", response.body.id);
%}

### Act 2
POST {{url}}/guides/{{guideId}}/nodes
Authorization: Bearer {{authorToken}}
Content-Type: application/json

{ "title": "Act 2", "content": "Act 2 overview", "storyOrderNumber": 2, "priorityNumber": 1 }

> {%
    client.test("Act 2 is created", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("act2Id", response.body.id);
%}

### Publish the setup guide, so the other test files can read it
POST {{url}}/guides/{{guideId}}/publish
Authorization: Bearer {{authorToken}}

> {%
    client.test("Setup guide is published", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}
